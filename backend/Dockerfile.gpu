# Optional private GPU container; GPU is NOT required when using Dockerfile.cpu.
# Hugging Face Spaces GPU Docker support may require provider-specific adjustments.
FROM nvidia/cuda:12.8.1-cudnn-runtime-ubuntu22.04
ENV DEBIAN_FRONTEND=noninteractive PIP_NO_CACHE_DIR=1 PYTHONUNBUFFERED=1
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-pip python3-dev python-is-python3 git ffmpeg libsndfile1 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
RUN git clone https://github.com/saurabhv749/supertonic3-voice-clone.git cloner \
 && cd cloner && git checkout 765ce5e27daa8d30937e2d0d8f9730280add5748
COPY backend/requirements.txt /app/server-requirements.txt
RUN python3 -m pip install --upgrade pip && python3 -m pip install -r /app/server-requirements.txt \
 && python3 -m pip install -r /app/cloner/requirements.txt huggingface_hub
# The original extractor expects the model tree under /app/cloner/supertonic3.
RUN hf download Supertone/supertonic-3 --local-dir /app/cloner/supertonic3 --quiet
COPY backend/app.py /app/app.py
RUN mkdir -p /tmp/voice_jobs && chmod 700 /tmp/voice_jobs
ENV CLONER_DIR=/app/cloner JOBS_DIR=/tmp/voice_jobs CLONE_DEVICE=auto CLONE_STEPS=3000
EXPOSE 7860
CMD ["python3", "-m", "uvicorn", "app:app", "--host", "0.0.0.0", "--port", "7860", "--workers", "1"]
